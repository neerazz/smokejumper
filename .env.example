# Local template. Copy to `.env`, which is git-ignored.
#
# Every value the settings object reads from the environment appears here.
# `config/*.yaml` is committed and therefore holds no secrets: secrets exist
# only as variables, supplied by this file locally and by the platform's secret
# manager in dev/prod (SPEC 2d).
#
# Nesting is a double underscore: SMOKEJUMPER__<SECTION>__<KEY>. Variables that
# are not needed yet stay commented out, because `FOO=` means "empty", not
# "unset", and boot rejects an empty number or list rather than guessing.

# --- Environment selection --------------------------------------------------
# Selects config/<env>.yaml. One of local | dev | prod; defaults to local.
SMOKEJUMPER_ENV=local

# Docker reads this too, so compose and the app never disagree about which
# services are running. Comma-separated: lab | fixtures | obs (SPEC 2c/2e).
# `lab` and `fixtures` are refused unless SMOKEJUMPER_ENV=local.
COMPOSE_PROFILES=

# --- Required in every environment ------------------------------------------
# Credential-bearing, so these live here and never in config/*.yaml.
SMOKEJUMPER__DATABASE__URL=postgresql+psycopg://smokejumper:change-me@postgres:5432/smokejumper
SMOKEJUMPER__REDIS__URL=redis://redis:6379/0

# Spend ceiling in USD. config/local.yaml defaults it to 1.00 and prod has no
# default at all: it fails closed rather than booting unlimited (SPEC 11.3).
SMOKEJUMPER__BUDGET__MAX_USD_PER_RUN=1.00

# --- Model provider (needed from M2) ----------------------------------------
# Required once ports.model is DirectProvider. No provider is chosen yet, so the
# role strings have no default (SPEC 11.4).
# SMOKEJUMPER__MODEL__WORKER=
# SMOKEJUMPER__MODEL__SYNTHESIS=
# SMOKEJUMPER__MODEL__API_KEY=

# Needed from M3, and immutable afterwards without a pgvector migration.
# SMOKEJUMPER__EMBEDDING__MODEL=
# SMOKEJUMPER__EMBEDDING__DIMENSION=

# --- Slack, Socket Mode (needed from M2) ------------------------------------
# Required once ports.channel is Slack. Socket Mode needs no signing secret.
# SLACK_BOT_TOKEN=
# SLACK_APP_TOKEN=
# SMOKEJUMPER__SLACK__CHANNEL_ID=

# --- Linear (needed from M2) ------------------------------------------------
# Required once ports.ticketing is Linear. PROJECT_ID is optional; omit it to
# create team-level issues.
# LINEAR_API_KEY=
# SMOKEJUMPER__TICKETING__TEAM_ID=
# SMOKEJUMPER__TICKETING__PROJECT_ID=

# --- Webhook verification (needed from M1) ----------------------------------
# Per-source shared secrets. Alertmanager signs nothing, so it is accepted only
# from the allowlisted networks (SPEC 5.1) — an empty allowlist accepts nothing.
# SMOKEJUMPER__WEBHOOKS__GRAFANA__SECRET=
# SMOKEJUMPER__WEBHOOKS__DATADOG__SECRET=
# SMOKEJUMPER__WEBHOOKS__PAGERDUTY__SECRET=
# SMOKEJUMPER__WEBHOOKS__GENERIC__SECRET=
# SMOKEJUMPER__WEBHOOKS__ALERTMANAGER_ALLOWLIST=["10.0.0.0/8","192.168.0.0/16"]

# --- Tool backends ----------------------------------------------------------
# config/local.yaml already points these at the `lab` compose services; set them
# only to reach a backend elsewhere.
# SMOKEJUMPER__TOOLS__PROMETHEUS_URL=
# SMOKEJUMPER__TOOLS__LOKI_URL=

# --- Flight Recorder --------------------------------------------------------
# Where the append-only JSONL audit files land (SPEC 5.8). Defaults to logs/.
# SMOKEJUMPER_LOG_DIR=

# --- Host port overrides ----------------------------------------------------
# Compose reads these, not the app. Defaults are in the port contract
# (SPEC 11.2); set one only to resolve a collision on this workstation.
# APP_HOST_PORT=8000
# POSTGRES_HOST_PORT=5432
# REDIS_HOST_PORT=6379
