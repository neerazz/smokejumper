%% Smokejumper — High-Level Architecture (v1, updated 2026-07-26)
%% Viewpoint: layered container view of the agentic SRE messaging bot core.
%% Audience: contributors (platform seam = B10). One question answered:
%%   "What are the blocks, the boundary contracts between them, and which parts
%%    are core (build) vs black-box ports (stubbed, platform provides later)?"
%% Editing: this .mmd is the source of truth; re-render the portable SVG with:
%%   python3 scripts/render_architecture.py
%% Styling: teal = core (you build) · dashed grey = black-box port / external ·
%%          amber = approval-gated · violet = knowledge / audit spine.
%% Topology (SPEC decision 17): three deployed services — postgres+pgvector, redis, app.
%%   There is no proxy tier: our MCP servers run inside the app process and the model
%%   port calls the provider SDK directly. Post-v1, and therefore absent here: the
%%   knowledge-graph tables with ≤2-hop expansion, and the Distiller.
%% Governance invariant (ADR-0017): EVERY tool call — sub-agent or knowledge federation —
%%   enters through GW. There is deliberately no edge that reaches CURLIX or a backend
%%   without crossing the gateway first.
%% B8 (AuditEvent): EVERY core block appends to the Flight Recorder;
%%   drawn once from the Intelligence layer to keep the layout readable.
%% Native SVG text is required so the committed render works outside browsers
%% that support foreignObject (PDF/rsvg/GitHub sanitizers included).
%%{init: {"htmlLabels": false, "themeCSS": "text { white-space: pre; }", "flowchart": {"htmlLabels": false}}}%%

flowchart TB
  accTitle: Smokejumper current and target v1 event flow
  accDescr: Current deterministic triage is shown separately from the target LangGraph supervisor, with governed MCP tools, knowledge, actions, and the JSONL flight recorder.

  %% ═══ LAYER 1 · SOURCES ══════════════════════════════════════
  subgraph L1["  ALERT & CHAT SOURCES  "]
    direction LR
    AM["Alertmanager<br/>webhook — local in lab profile"]
    GRAF["Grafana<br/>webhook — recorded-payload replay"]
    DD["Datadog<br/>webhook — SaaS, recorded-payload replay"]
    PD["PagerDuty<br/>webhook v3 — signed raw body"]
    GEN["Splunk / generic<br/>JSON"]
    SLACKIN["Slack<br/>@mention · buttons"]
    AM ~~~ GRAF ~~~ DD ~~~ PD ~~~ GEN ~~~ SLACKIN
  end

  %% ═══ LAYER 2 · INGESTION ════════════════════════════════════
  subgraph L2["  INGESTION — deterministic, no LLM  "]
    direction LR
    RECV["RECEIVER<br/>verify · normalize to AgentEvent<br/>fingerprint · dedupe"]
    OUTBOX[("POSTGRES EVENTS OUTBOX<br/>admission + queue receipt<br/>retry pending delivery")]
    QUEUE(["Redis Streams<br/>inbox queue · burst absorption"])
    RECV -- "commit B2" --> OUTBOX
    OUTBOX -- "at-least-once XADD" --> QUEUE
  end

  PORTS["AUTH · GOVERNANCE · TENANCY — ports (black box)<br/>webhook verification · Slack Socket Mode auth · credentials<br/>approval tokens · org scoping<br/>v1 substitutes: AllowAll / NoopGovernance; SingleTenant is real"]

  %% ═══ LAYER 3 · INTELLIGENCE ═════════════════════════════════
  subgraph L3["  INTELLIGENCE — target v1 LangGraph; deterministic triage is current  "]
    direction LR
    REG["AGENT REGISTRY<br/>declarative · versioned<br/>prompt · tool allowlist<br/>budget · dispatch triggers"]
    ORCH["ORCHESTRATOR (target supervisor)<br/>intake → retrieve → dispatch<br/>→ aggregate Findings<br/>→ synthesize Conclusion"]
    TRIAGE["CURRENT TRIAGE<br/>alert-grounded · deterministic<br/>needs_human / inconclusive only"]
    AGENTS["SPECIALIST SUB-AGENTS — parallel · stateless · budgeted<br/>DB Investigator · Metrics Analyst · Log Analyst<br/>Code Investigator · Change Auditor · Precedent Researcher"]
    REG -- "spins up" --> ORCH
    ORCH -- "B11 Assignment → Finding" --> AGENTS
  end

  GOVSCHED["GOVERNOR + SCHEDULER (cross-cutting)<br/>iteration, token and spend budgets · circuit breakers<br/>storm brake · registry sync<br/>scheduled investigations"]

  MODELS["MODEL PROVIDER — ports/model.py<br/>the only model-call seam · provider SDK direct<br/>roles: worker · synthesis; embedding is a separate call shape<br/>records prompt ref/hash, usage, cost"]

  %% ═══ LAYER 4 · KNOWLEDGE & TOOLS ════════════════════════════
  subgraph L4K["  RAG / KNOWLEDGE  "]
    direction TB
    FACADE["KNOWLEDGE FAÇADE<br/>retrieve(ctx) → KnowledgeBundle<br/>episode similarity + matching recipes,<br/>under a token budget"]
    MODS["MODALITIES<br/>① Vector store (pgvector) — episodic memory, bi-temporal<br/>② Knowledge graph — POST-V1, behind MemoryPort<br/>③ Recipe registry (YAML) — interpret → freeze → synthesize<br/>④ Federated — via the MCP gateway, never a second client"]
    FACADE --- MODS
  end

  subgraph L4H["  MCP DOMAIN — one client · one tier manifest (ADR-0017)  "]
    direction TB
    GW["GATEWAY — the only MCP client<br/>FastMCP middleware · central manifest.yaml<br/>+ redundant executor check"]
    READT["READ TIER<br/>metric query · log search · knowledge.search<br/>Linear read · recipe read · asset query"]
    PRIVT["PRIVILEGED TIER<br/>destructive ops: suspend graph<br/>→ approval → single-use token<br/>(minted by Auth port)"]
    GW --> READT
    GW --> PRIVT
  end

  BACKENDS["TOOL BACKENDS (lab compose profile)<br/>Prometheus — metrics · Loki — logs<br/>faultbox — injectable faults for eval ground truth"]

  APPROVE["Slack approval UI<br/>approve / deny buttons"]

  %% ═══ LAYER 5 · EXECUTION & AUDIT ════════════════════════════
  subgraph L5["  EXECUTION & AUDIT  "]
    direction LR
    ACT["ACTIONS — deterministic, no LLM<br/>current: run-idempotent fixture ticket<br/>target: Linear + Slack receipts<br/>same fingerprint/run idempotency key"]
    FR["FLIGHT RECORDER — append-only audit spine (JSONL files, ADR-0012)<br/>events · node transitions · every LLM + tool call<br/>gates · actions · powers replay/eval harness<br/>+ per-agent hit-rate stats · Postgres holds the run→file/offset index"]
    ACT ~~~ FR
  end

  CURLIX["CURLIX PLATFORM (external)<br/>skills execution · inventory / asset graph<br/>findings write-back · existing MCP server"]

  %% ═══ Primary path (bold) ════════════════════════════════════
  L1 == "B1 verified inbound" ==> RECV
  QUEUE == "current" ==> TRIAGE
  QUEUE -. "target v1" .-> ORCH
  TRIAGE == "B6 Conclusion" ==> ACT
  ORCH == "B6 Conclusion — determinism boundary" ==> ACT

  %% ═══ Secondary paths ══════════════════════════════════════
  PORTS -.-> RECV
  ORCH -- "B3 retrieve → KnowledgeBundle" --> FACADE
  AGENTS -- "B4 — ALL tool calls enter here" --> GW
  L3 -- "every model call" --> MODELS
  PRIVT -- "B5 approval round-trip" --> APPROVE
  READT -- "queries" --> BACKENDS
  READT -- "B10 API contract" --> CURLIX
  MODS -. "④ federation — governed, tiered" .-> GW
  L3 -- "B8 AuditEvent — every block" --> FR
  MODELS -. "B8 llm_call" .-> FR
  GOVSCHED -.- L3

  %% ═══ Styling ════════════════════════════════════════════════
  classDef core fill:#e3f3f6,stroke:#0b7285,color:#0b3a42;
  classDef port fill:#f1f3f5,stroke:#5b6b7a,stroke-dasharray:5 4,color:#3d4852;
  classDef gate fill:#fbf0da,stroke:#9a6700,color:#5c3d00;
  classDef learn fill:#efeafb,stroke:#6741b8,color:#2f1e5c;
  classDef queue fill:#f8f9fa,stroke:#868e96,color:#343a40;
  classDef layer fill:#fffdf5,stroke:#b8a800,color:#5c5400;

  class RECV,OUTBOX,TRIAGE,ORCH,REG,AGENTS,GW,READT,ACT,GOVSCHED,MODELS core;
  class PORTS,CURLIX,AM,GRAF,DD,PD,GEN,SLACKIN,APPROVE,BACKENDS port;
  class PRIVT gate;
  class FACADE,MODS,FR learn;
  class QUEUE queue;
  class L1,L2,L3,L4K,L4H,L5 layer;
